# Copy to .env and fill in. Never commit .env.
# Local dev needs none of these (dev settings use SQLite + defaults);
# production (config.settings.prod) requires the ones marked REQUIRED.

# --- Django ---------------------------------------------------------------
SECRET_KEY=change-me                       # REQUIRED in prod (python -c "import secrets; print(secrets.token_urlsafe(50))")
JWT_SECRET_KEY=change-me                   # REQUIRED in prod
DEBUG=False
# Keep localhost in the list: the docker healthcheck calls http://localhost:8000/health/
ALLOWED_HOSTS=api.bondah.org,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.bondah.org,https://bondah.org,https://www.bondah.org,https://adminconsole.bondah.org
CORS_ALLOWED_ORIGINS=https://bondah.org,https://www.bondah.org,https://adminconsole.bondah.org
LOG_LEVEL=INFO

# --- Database (docker-compose builds DATABASE_URL from these) ----------------
POSTGRES_DB=bondah
POSTGRES_USER=bondah
POSTGRES_PASSWORD=change-me                # REQUIRED for docker-compose
# Outside docker-compose, set the URL directly instead:
# DATABASE_URL=postgres://bondah:password@localhost:5432/bondah
# DB_SSL_REQUIRE=False

# --- Redis (docker-compose sets REDIS_URL itself) ----------------------------
# REDIS_URL=redis://localhost:6379/0

# --- Email (Brevo) ----------------------------------------------------------
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@bondah.org
# False = emails (including OTPs) are only logged, not sent.
ENABLE_EMAIL_SENDING=False

# --- Firebase (push notifications / Firestore) ------------------------------
# Either the JSON content on one line, or a path to the service-account file.
FIREBASE_CREDENTIALS_JSON=
# FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json

# --- Cloudinary (media uploads) ---------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OAuth ------------------------------------------------------------------
APPLE_CLIENT_ID=
APPLE_SECRET=
APPLE_KEY=

# --- In-app purchases -------------------------------------------------------
APPLE_SHARED_SECRET=
# GOOGLE_PLAY_KEY_PATH=/app/secrets/google_play_key.json

# --- Other ------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
